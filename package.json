{
  "name": "hellens-clipper",
  "version": "1.0.0",
  "description": "Pemotong klip pendek bertenaga AI (lokal)",
  "main": "main.js",
  "scripts": {
    "server": "node server.js",
    "central": "node --no-warnings central/server.js",
    "build": "vite build",
    "test": "node --test test/*.test.js && bash scripts/auth-check.sh",
    "dev": "vite",
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "vite": "^8.3.3"
  },
  "build": {
    "appId": "com.hellens.app",
    "directories": {
      "output": "release"
    },
    "productName": "Hellens Clipper",
    "files": [
      "main.js",
      "server.js",
      "index.html",
      "dist/**",
      "lib/**",
      "scripts/**",
      "fonts/**",
      "brand/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    },
    "dmg": {
      "icon": false
    }
  },
  "productName": "Hellens Clipper",
  "dependencies": {
    "puppeteer-core": "^25.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
